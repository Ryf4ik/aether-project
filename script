local function isAlly(p)
    if not settings.aimTeamCheck then return false end
    return LocalPlayer.Team ~= nil and p.Team == LocalPlayer.Team
end

local function isInCombat()
    local char = LocalPlayer.Character
    if not char then return false end
    if char:FindFirstChildWhichIsA("Tool") then return true end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then return true end
        end
    end
    return false
end

local esp3DObjects = {}
local originalSky = nil
local customSky = nil

local function apply3DESP(character)
    if not character or character == LocalPlayer.Character then return end
    if esp3DObjects[character] then return end
    local hideParent = character:FindFirstChild("HumanoidRootPart") 
    if not hideParent then return end
    local h = Instance.new("Highlight")
    h.Adornee = character
    h.FillColor = settings.espColor
    h.FillTransparency = settings.espTransparency
    h.OutlineColor = Color3.fromRGB(255, 255, 255)
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = hideParent
    esp3DObjects[character] = h
end

local function remove3DESP(character)
    if esp3DObjects[character] then esp3DObjects[character]:Destroy(); esp3DObjects[character] = nil end
end

local function applyHitbox(character)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.Size = Vector3.new(settings.hitboxSize, settings.hitboxSize, settings.hitboxSize)
        hrp.Transparency = 0.7
        hrp.CanCollide = false
    end
end

local function resetHitbox(character)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.Size = Vector3.new(2, 2, 1)
        hrp.Transparency = 1
        hrp.CanCollide = true
    end
end

local function toggleSky(state)
    if state then
        -- Сохраняем оригинальное небо
        originalSky = Lighting:FindFirstChildOfClass("Sky")
        if originalSky then
            originalSky.Parent = nil -- Прячем оригинал
        end
        
        -- Создаем кастомное небо (Космос/Ночь)
        customSky = Instance.new("Sky")
        customSky.SkyboxBk = "rbxassetid://159454299"
        customSky.SkyboxDn = "rbxassetid://159454296"
        customSky.SkyboxFt = "rbxassetid://159454293"
        customSky.SkyboxLf = "rbxassetid://159454286"
        customSky.SkyboxRt = "rbxassetid://159454300"
        customSky.SkyboxUp = "rbxassetid://159454288"
        customSky.Parent = Lighting
    else
        -- Удаляем кастомное небо
        if customSky then
            customSky:Destroy()
            customSky = nil
        end
        -- Возвращаем оригинал
        if originalSky then
            originalSky.Parent = Lighting
            originalSky = nil
        end
    end
end

local function hookPlayer(p)
    if p == LocalPlayer then return end
    p.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        if settings.esp3DEnabled then apply3DESP(char) end
        if settings.hitboxEnabled then applyHitbox(char) end
    end)
    if p.Character then 
        if settings.esp3DEnabled then apply3DESP(p.Character) end
        if settings.hitboxEnabled then applyHitbox(p.Character) end
    end
end
Players.PlayerAdded:Connect(hookPlayer)
for _, p in ipairs(Players:GetPlayers()) do hookPlayer(p) end

local cameraConnection = nil
local originalCameraType = Camera.CameraType

local function getClosestTarget()
    local best, bestDist = nil, math.huge
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and not isAlly(p) then
            local head = p.Character:FindFirstChild("Head")
            local hum = p.Character:FindFirstChild("Humanoid")
            if head and hum and hum.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen and pos.Z > 0 then
                    local d = (center - Vector2.new(pos.X, pos.Y)).Magnitude
                    local visible = true
                    if settings.aimVisibleCheck then
                        local rayParams = RaycastParams.new()
                        rayParams.FilterDescendantsInstances = {LocalPlayer.Character, p.Character}
                        rayParams.FilterType = Enum.RaycastFilterType.Exclude
                        visible = (workspace:Raycast(Camera.CFrame.Position, head.Position - Camera.CFrame.Position, rayParams) == nil)
                    end
                    if visible and d <= settings.aimFOV and d < bestDist then 
                        best, bestDist = head, d 
                    end
                end
            end
        end
    end
    return best
end

local function startAim()
    if cameraConnection then return end
    originalCameraType = Camera.CameraType
    Camera.CameraType = Enum.CameraType.Scriptable
    cameraConnection = RunService.RenderStepped:Connect(function()
        if not settings.aimEnabled then return end
        if not isInCombat() then return end 
        local target = getClosestTarget()
        if target then
            local targetCFrame = CFrame.new(Camera.CFrame.Position, target.Position)
            if settings.aimSmoothness > 0 then
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 1 - settings.aimSmoothness)
            else
                Camera.CFrame = targetCFrame
            end
        end
    end)
end

local function stopAim()
    if cameraConnection then 
        cameraConnection:Disconnect() 
        cameraConnection = nil 
    end
    Camera.CameraType = Enum.CameraType.Custom
    local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
    if playerScripts then
        local playerModule = playerScripts:FindFirstChild("PlayerModule")
        if playerModule then
            pcall(function()
                local cameras = require(playerModule):GetCameras()
                if cameras and cameras[1] then cameras[1]:Enable(true) end
            end)
        end
    end
end

