createKeybind(settingsPage, "Menu Key", settings.menuKey, function(key) settings.menuKey = key end)
createSlider(settingsPage, "UI Scale", 0.5, 1.5, settings.uiScale, function(val) 
    settings.uiScale = val
    uiScaleObj.Scale = val
end)

track(UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == settings.menuKey then
        mainFrame.Visible = not mainFrame.Visible
    elseif input.KeyCode == settings.aimKey then
        if settings.aimHold then
            settings.aimEnabled = true
            startAim()
        else
            settings.aimEnabled = not settings.aimEnabled
            if settings.aimEnabled then startAim() else stopAim() end
        end
    end
end))

track(UserInputService.InputEnded:Connect(function(input)
    if settings.aimHold and input.KeyCode == settings.aimKey then
        settings.aimEnabled = false
        stopAim()
    end
end))
